{
  "model": {
    "method": "icae",
    "name_or_path": "meta-llama/Llama-3.2-1B-Instruct",
    "revision": "main",
    "dtype": "bfloat16",
    "attn_implementation": "sdpa",
    "compress_ratio": 32,
    "ratio_mode": "fixed",
    "random_ratios": [
      4,
      8,
      16,
      32
    ],
    "lora_r": 128,
    "lora_alpha": 256,
    "lora_dropout": 0.0,
    "memory_slots": 32,
    "full_tail_slots": true,
    "keep_ae_marker": true,
    "lora_target_modules": [
      "q_proj",
      "v_proj"
    ]
  },
  "data": {
    "prepared_dir": "artifacts/icae/Llama-3.2-1B-Instruct/niah/prepared/train_v1",
    "require_pretrained": true
  },
  "training": {
    "per_device_train_batch_size": 1,
    "gradient_accumulation_steps": 8,
    "learning_rate": 1e-05,
    "num_train_epochs": 1,
    "max_steps": -1,
    "lr_scheduler_type": "cosine",
    "warmup_ratio": 0.1,
    "weight_decay": 0.01,
    "max_grad_norm": 1,
    "gradient_checkpointing": true,
    "save_strategy": "steps",
    "save_steps": 500,
    "save_total_limit": 3,
    "logging_steps": 10,
    "dataloader_num_workers": 2,
    "dataloader_pin_memory": true,
    "seed": 42,
    "data_seed": 42,
    "report_to": "none",
    "optim": "adamw_torch",
    "eval_strategy": "no"
  }
}
